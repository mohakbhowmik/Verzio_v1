<file path="templates/dashboard.html">
{% extends "base.html" %}

{% block title %}Overview — Verzio Studio{% endblock %}
{% block page_title %}Overview{% endblock %}

{% block content %}
<!-- ==================== TOP METRICS (Operational States) ==================== -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="metric-card">
            <span class="metric-label">Active businesses</span>
            <div class="d-flex align-items-baseline gap-2">
                <span class="metric-value">{{ active_business_count }}</span>
                <span class="cell-muted">/ {{ total_business_count }}</span>
            </div>
        </div>
