{% extends "owner_base_mobile.html" if mobile else "owner/base.html" %}

{% block title %}New Booking — Verzio Studio{% endblock %}
{% block page_title %}New Booking{% endblock %}

{% block content %}
<div class="form-workspace" style="max-width: 640px;">

  <div class="breadcrumb-verzio">
    <a href="/owner/appointments"><i class="bi bi-arrow-left me-2"></i> Back to Appointments</a>
  </div>

  <div class="mb-3">
    <h1 class="h5 fw-bold mb-1">Add a booking</h1>
    <p class="text-muted small mb-0">For walk-ins and phone bookings. The slot is blocked on WhatsApp immediately.</p>
  </div>

  {% if error %}
  <div class="alert alert-danger small">{{ error }}</div>
  {% endif %}

  {% if not services %}
  <div class="alert alert-warning small">
    You have no active services yet. <a href="/owner/services/new">Add a service</a> first.
  </div>
  {% else %}
  <form method="post" action="/owner/appointments/manual">
    <div class="section-container mb-3">
      <div class="section-head"><h2 class="section-title">Customer</h2></div>
      <div class="p-3">
        <label class="form-label small fw-bold text-muted" for="customer_name">Name</label>
        <input type="text" id="customer_name" name="customer_name" class="form-control mb-3"
               value="{{ values.customer_name }}" placeholder="e.g. Priya Sharma" maxlength="120">

        <label class="form-label small fw-bold text-muted" for="customer_phone">Mobile number</label>
        <input type="tel" id="customer_phone" name="customer_phone" class="form-control"
               value="{{ values.customer_phone }}" placeholder="e.g. 9876543210" inputmode="tel">
        <div class="form-text">Optional for walk-ins. Needed if you want WhatsApp updates sent to them later.</div>
      </div>
    </div>

    <div class="section-container mb-3">
      <div class="section-head"><h2 class="section-title">Booking</h2></div>
      <div class="p-3">
        <label class="form-label small fw-bold text-muted" for="service_id">Service</label>
        <select id="service_id" name="service_id" class="form-select mb-3" required>
          <option value="" disabled {% if not values.service_id %}selected{% endif %}>Choose a service</option>
          {% for s in services %}
          <option value="{{ s.id }}" {% if values.service_id == s.id|string %}selected{% endif %}>
            {{ s.name }} · {{ s.duration }} min{% if s.price is not none %} · ₹{{ '%.0f'|format(s.price) }}{% endif %}
          </option>
          {% endfor %}
        </select>

        <div class="row g-2">
          <div class="col-6">
            <label class="form-label small fw-bold text-muted" for="date">Date</label>
            <input type="date" id="date" name="date" class="form-control" value="{{ values.date }}" required>
          </div>
          <div class="col-6">
            <label class="form-label small fw-bold text-muted" for="time">Time</label>
            <input type="time" id="time" name="time" class="form-control" value="{{ values.time }}"
                   step="{{ (business.slot_interval or 30) * 60 }}" required>
          </div>
        </div>

        <div class="form-check mt-3">
          <input class="form-check-input" type="checkbox" id="allow_overbook" name="allow_overbook" {% if allow_overbook %}checked{% endif %}>
          <label class="form-check-label small" for="allow_overbook">
            Override availability checks (the customer is already here)
          </label>
        </div>
      </div>
    </div>

    <div class="d-flex gap-2 justify-content-end">
      <a href="/owner/appointments" class="btn btn-outline-secondary">Cancel</a>
      <button type="submit" class="btn btn-primary px-4">Save booking</button>
    </div>
  </form>
  {% endif %}
</div>
{% endblock %}
</file>

