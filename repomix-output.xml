<file path="templates/owner/dashboard.html">
{% extends "owner/base.html" %}

{% block title %}Dashboard — Verzio Studio{% endblock %}
{% block page_title %}Dashboard{% endblock %}
{% block extra_head %}
<link rel="stylesheet" href="{{ url_for('static', path='css/mobile.css') }}">
{% endblock %}

{% block content %}
<div class="d-none d-lg-block">
<div class="page-header mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-soft-accent text-accent fw-bold px-2 py-1" style="font-size: 10px;">OWNER PORTAL</span>
        </div>
        <h1 class="page-title" style="margin:0;">{{ business.name if business else 'Dashboard' }}</h1>
        <p class="page-subtitle" style="margin-top:4px;">Manage your daily operations, capacity, and recent bookings.</p>
    </div>
