"""
booking_engine.py — Core calendar availability and atomic booking engine.
Supports unified appointment_time DateTime schema.
Implements C1 (duration-aware slot overlaps) and C2 (atomic concurrency locking).
"""
import logging
from datetime import datetime, date, time, timedelta
from typing import Tuple, Optional, List, Any
from sqlalchemy.orm import Session
from sqlalchemy import text
from database import Business, Service, Appointment

logger = logging.getLogger("VERZIO_BOOKING_ENGINE")

ERR_CAPACITY = "ERR_CAPACITY"
ERR_OUTSIDE_HOURS = "ERR_OUTSIDE_HOURS"
ERR_HOLIDAY = "ERR_HOLIDAY"
ERR_TENANT_LOCKED = "ERR_TENANT_LOCKED"
ERR_INVALID_SERVICE = "ERR_INVALID_SERVICE"
ERR_PAST_TIME = "ERR_PAST_TIME"


class BookingEngineException(Exception):
    def __init__(self, code: str = "ERR_UNKNOWN", message: str = ""):
        self.code = code
        self.message = message or code
        super().__init__(self.message)


class CapacityError(BookingEngineException):
    def __init__(self, message: str = "Capacity limit reached"):
        super().__init__(ERR_CAPACITY, message)


class OutsideHoursError(BookingEngineException):
    def __init__(self, message: str = "Outside business hours"):
        super().__init__(ERR_OUTSIDE_HOURS, message)


class InvalidServiceError(BookingEngineException):
    def __init__(self, message: str = "Invalid or inactive service"):
        super().__init__(ERR_INVALID_SERVICE, message)


class BookingEngineCode(str):
    def __new__(cls, code: str, friendly_msg: str = ""):
        s = super().__new__(cls, code)
        s.code = code
        s.friendly_msg = friendly_msg or code
        return s

    def __str__(self):
        return self.friendly_msg

    def __format__(self, format_spec):
        return self.friendly_msg


def is_holiday(db: Session, business_id: int, target_date: date) -> bool:
    return False


def get_available_slots_for_day(
    db: Session,
    business: Business,
    target_date: date,
    service: Optional[Service] = None
) -> List[str]:
    """
    C1: Duration-aware slot calculator.
    - Prevents overlapping appointments from exceeding max_parallel_bookings.
    - Ensures service completes before closing.
    - Filters out elapsed times for today.
    """
    if not business.accepting_bookings:
        return []

    if is_holiday(db, business.id, target_date):
        return []

    weekday_str = target_date.strftime("%a").lower()[:3]
    hours = (business.operational_hours or {}).get(weekday_str)
    if not hours or len(hours) < 2:
        return []

    try:
        open_time = datetime.strptime(hours[0], "%H:%M").time()
        close_time = datetime.strptime(hours[1], "%H:%M").time()
    except (ValueError, TypeError):
        return []

    open_dt = datetime.combine(target_date, open_time)
    close_dt = datetime.combine(target_date, close_time)

    duration_mins = service.duration if (service and service.duration) else (business.slot_interval or 30)
    service_duration = timedelta(minutes=duration_mins)
    slot_interval = timedelta(minutes=business.slot_interval or 30)
    max_capacity = business.max_parallel_bookings or 1

    # Query using start and end of target day
    day_start = datetime.combine(target_date, time.min)
    day_end = datetime.combine(target_date, time.max)

    existing_appts = (
        db.query(Appointment)
        .filter(
            Appointment.business_id == business.id,
            Appointment.appointment_time >= day_start,
            Appointment.appointment_time <= day_end,
            Appointment.status.in_(["pending", "confirmed"])
        )
        .all()
    )

    booked_intervals = []
    for appt in existing_appts:
        appt_start = appt.appointment_time
        appt_dur = appt.service.duration if (appt.service and appt.service.duration) else (business.slot_interval or 30)
        booked_intervals.append((appt_start, appt_start + timedelta(minutes=appt_dur)))

    now = datetime.now()
    available_slots = []
    current_slot = open_dt

    while current_slot + service_duration <= close_dt:
        slot_start = current_slot
        slot_end = current_slot + service_duration

        if target_date == now.date() and slot_start <= now:
            current_slot += slot_interval
            continue

        overlapping_count = sum(
            1 for b_start, b_end in booked_intervals
            if b_start < slot_end and b_end > slot_start
        )

        if overlapping_count < max_capacity:
            available_slots.append(slot_start.strftime("%H:%M"))

        current_slot += slot_interval

    return available_slots


def validate_and_book(*args, **kwargs) -> Tuple[bool, str, Optional[Appointment]]:
    """
    C2 & W6: Atomic booking validation storing combined appointment_time.
    """
    call_args = list(args)
    if call_args and isinstance(call_args[0], VerzioSaaSEngine):
        call_args.pop(0)

    db: Session = kwargs.get("db", call_args[0] if call_args else None)
    rem = call_args[1:]

    business_id = kwargs.get("business_id", kwargs.get("tenant_id"))
    service_id = kwargs.get("service_id")
    customer_phone = kwargs.get("customer_phone", kwargs.get("phone", ""))
    customer_name = kwargs.get("customer_name", "Client")
    target_date = kwargs.get("target_date")
    target_time = kwargs.get("target_time")

    if rem:
        if len(rem) >= 2 and isinstance(rem[1], (datetime, date)):
            business_id = rem[0]
            dt_val = rem[1]
            if isinstance(dt_val, datetime):
                target_date = dt_val.date()
                target_time = dt_val.time()
            else:
                target_date = dt_val
                target_time = time(9, 0)
            if len(rem) > 2:
                customer_phone = str(rem[2])
            if len(rem) > 3:
                service_id = int(rem[3])
            if len(rem) > 4:
                customer_name = str(rem[4])
        elif len(rem) >= 5:
            business_id = rem[0]
            service_id = int(rem[1])
            customer_phone = str(rem[2])
            target_date = rem[3]
            target_time = rem[4]
            if len(rem) > 5:
                customer_name = str(rem[5])

    if isinstance(target_date, str):
        target_date = datetime.strptime(target_date, "%Y-%m-%d").date()
    if isinstance(target_time, str):
        target_time = datetime.strptime(target_time, "%H:%M" if len(target_time) == 5 else "%H:%M:%S").time()

    try:
        db.execute(text("BEGIN IMMEDIATE"))
    except Exception:
        pass

    biz = db.query(Business).filter(Business.id == business_id).first()
    if not biz or not biz.accepting_bookings:
        db.rollback()
        return False, BookingEngineCode(ERR_TENANT_LOCKED, "This business is currently not accepting bookings."), None

    if is_holiday(db, business_id, target_date):
        db.rollback()
        return False, BookingEngineCode(ERR_HOLIDAY, "The business is closed for a holiday on this date."), None

    service = db.query(Service).filter(
        Service.id == service_id,
        Service.business_id == business_id,
        Service.is_active == True,
        Service.is_deleted == False
    ).first()
    if not service:
        db.rollback()
        return False, BookingEngineCode(ERR_INVALID_SERVICE, "The selected service is no longer available."), None

    now = datetime.now()
    combined_dt = datetime.combine(target_date, target_time)
    if combined_dt <= now:
        db.rollback()
        return False, BookingEngineCode(ERR_PAST_TIME, "This appointment time is in the past."), None

    available_slots = get_available_slots_for_day(db, biz, target_date, service)
    time_str = target_time.strftime("%H:%M")
    if time_str not in available_slots:
        db.rollback()
        return False, BookingEngineCode(ERR_CAPACITY, "Sorry, this slot was just taken or is no longer available."), None

    initial_status = "confirmed" if biz.approval_mode == "automatic" else "pending"

    appt = Appointment(
        business_id=biz.id,
        service_id=service.id,
        customer_phone=customer_phone,
        customer_name=customer_name or "Client",
        appointment_time=combined_dt,
        status=initial_status
    )
    db.add(appt)
    db.commit()
    db.refresh(appt)

    logger.info(f"Booked appointment #{appt.id} for {customer_phone} at business #{biz.id} ({initial_status})")
    return True, "SUCCESS", appt


class VerzioSaaSEngine:
    ERR_CAPACITY = ERR_CAPACITY
    ERR_OUTSIDE_HOURS = ERR_OUTSIDE_HOURS
    ERR_HOLIDAY = ERR_HOLIDAY
    ERR_TENANT_LOCKED = ERR_TENANT_LOCKED
    ERR_INVALID_SERVICE = ERR_INVALID_SERVICE

    def __init__(self, *args, **kwargs):
        pass

    def get_available_slots(self, *args, **kwargs):
        return get_available_slots_for_day(*args, **kwargs)

    def get_available_slots_for_day(self, *args, **kwargs):
        return get_available_slots_for_day(*args, **kwargs)

    def validate_and_book(self, *args, **kwargs):
        return validate_and_book(*args, **kwargs)

    def is_holiday(self, *args, **kwargs):
        return is_holiday(*args, **kwargs)


engine = VerzioSaaSEngine()
