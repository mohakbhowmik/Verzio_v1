                    {% if not business %}
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label small fw-bold">Owner Name</label>
                            <input type="text" name="owner_name" class="form-control form-control-sm" placeholder="e.g. Rahul Sharma" required>
