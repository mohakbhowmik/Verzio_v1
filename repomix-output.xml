        <div class="owner-mobile-card p-2 mb-2">
            <div class="small fw-bold text-muted text-uppercase mb-2">Scheduling rules</div>
            <label class="small text-muted">Slot interval</label>
            <select class="form-select form-select-sm mt-1 mb-2" name="slot_duration">
                <option value="5" {% if business.slot_interval == 5 %}selected{% endif %}>5 mins</option>
                <option value="10" {% if business.slot_interval == 10 %}selected{% endif %}>10 mins</option>
                <option value="15" {% if business.slot_interval == 15 %}selected{% endif %}>15 mins</option>
                <option value="30" {% if business.slot_interval == 30 or not business.slot_interval %}selected{% endif %}>30 mins</option>
                <option value="45" {% if business.slot_interval == 45 %}selected{% endif %}>45 mins</option>
                <option value="60" {% if business.slot_interval == 60 %}selected{% endif %}>1 hour</option>
                <option value="90" {% if business.slot_interval == 90 %}selected{% endif %}>1 hr 30 mins</option>
                <option value="120" {% if business.slot_interval == 120 %}selected{% endif %}>2 hours</option>
            </select>
            <label class="small text-muted">Advance window (days)</label>
            <input type="number" class="form-control form-control-sm mt-1 mb-2" name="advance_booking_days" value="{{ business.advance_booking_days }}">
            <label class="small text-muted">Parallel capacity</label>
            <input type="number" class="form-control form-control-sm mt-1" name="max_parallel_bookings" value="{{ business.max_parallel_bookings }}">
        </div>

        <div class="owner-mobile-card p-2 mb-2">
            <div class="small fw-bold text-muted text-uppercase mb-2">Operational hours</div>
            <div class="d-flex flex-column gap-2">
                {% for row in hours_rows %}
                <div class="border rounded-3 p-2">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-bold">{{ row.label }}</span>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" name="hours_{{ row.key }}_enabled" {% if not row.closed %}checked{% endif %}>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <input type="time" class="form-control form-control-sm" name="hours_{{ row.key }}_open" value="{{ row.open }}">
                        <input type="time" class="form-control form-control-sm" name="hours_{{ row.key }}_close" value="{{ row.close }}">
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>

        <div class="owner-mobile-card p-2">
            <button type="submit" class="btn btn-primary btn-sm w-100">Save Changes</button>
        </div>
    </form>
</section>
{% endblock %}
</file>

