{% extends "base.html" %}

{% block title %}Settings — Verzio Studio{% endblock %}

{% block content %}
<div class="page-header">
  <div>
    <div class="page-eyebrow">Configuration</div>
    <h1 class="page-title">Settings</h1>
    <div class="page-subtitle">Booking rules for Verzio Parallel Salon.</div>
  </div>
  <button class="btn-verzio-primary" data-action="save-settings"><i class="bi bi-check2 me-1"></i> Save changes</button>
</div>

<div class="row g-3">
  <div class="col-lg-8">

    <!-- ---- Operational hours ---- -->
    <div class="settings-panel">
      <div class="settings-panel-head">
        <h3>Operational hours</h3>
        <p>When customers can book appointments through WhatsApp.</p>
      </div>
      <div class="settings-panel-body">
        <div class="d-flex flex-column gap-2">
          {% set hours = [
            {"day": "Monday", "open": "09:00", "close": "18:00", "enabled": true},
            {"day": "Tuesday", "open": "09:00", "close": "18:00", "enabled": true},
            {"day": "Wednesday", "open": "09:00", "close": "18:00", "enabled": true},
            {"day": "Thursday", "open": "09:00", "close": "18:00", "enabled": true},
            {"day": "Friday", "open": "09:00", "close": "18:00", "enabled": true},
            {"day": "Saturday", "open": "10:00", "close": "15:00", "enabled": true},
            {"day": "Sunday", "open": "—", "close": "—", "enabled": false},
