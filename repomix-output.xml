<file path="templates/business_form.html">
{% extends "base.html" %}

{% block title %}
  {% if business %}Edit {{ business.name }}{% else %}New Business{% endif %} — Verzio Studio
{% endblock %}

{% block page_title %}
  {% if business %}Edit Business{% else %}New Business{% endif %}
{% endblock %}

{% block content %}
<form action="{{ form_action }}" method="post">

{% if error %}
<div class="alert alert-danger mb-4">
    {{ error }}
</div>
{% endif %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h4 mb-0 fw-bold">{% if business %}Update Tenant Details{% else %}Register New Tenant{% endif %}</h1>
            <p class="text-muted small mb-0">Configure core identity and booking logic for this business.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/admin/businesses" class="btn-console-outline">Cancel</a>
            <button type="submit" class="btn-verzio-primary">
                Save Business
            </button>
        </div>
    </div>

    <div class="row g-4">
        <!-- LEFT COLUMN: Identity & Hours -->
        <div class="col-lg-7">
            <!-- Identity Section -->
            <div class="section-container mb-4">
