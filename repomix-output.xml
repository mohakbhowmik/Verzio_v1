{% extends "owner/base.html" %}

{% block title %}Services — Verzio Studio{% endblock %}
{% block page_title %}Services{% endblock %}

{% block content %}
<div class="page-header">
  <div>
    <h1 class="page-title">Services</h1>
    <div class="page-subtitle">Service catalog for your current tenant only.</div>
  </div>
  <a href="/owner/services/new" class="btn-verzio-primary"><i class="bi bi-plus-lg me-1"></i> Add service</a>
</div>

<div class="filter-bar">
  <input type="text" class="form-control-verzio" style="max-width:260px;" placeholder="Search services…" data-table-search="#services-table">
</div>

<div class="table-verzio-wrap" id="services-table">
  <table class="table table-verzio align-middle mb-0">
    <thead>
      <tr>
        <th>Name</th>
        <th>Duration</th>
        <th>Price</th>
        <th>Status</th>
        <th class="text-end">Actions</th>
      </tr>
    </thead>
    <tbody>
      {% for service in services %}
      <tr>
        <td>
          <div class="table-entity">
            <div class="table-avatar">{{ service.name[:2]|upper }}</div>
            <div class="cell-primary">{{ service.name }}</div>
          </div>
        </td>
        <td class="cell-secondary">{{ service.duration }} mins</td>
        <td class="cell-secondary">{% if service.price is not none %}₹{{ '%.0f'|format(service.price) }}{% else %}—{% endif %}</td>
        <td>
          {% if service.is_active %}
            <span class="status-badge status-active"><span class="dot"></span>Active</span>
          {% else %}
            <span class="status-badge status-inactive"><span class="dot"></span>Inactive</span>
          {% endif %}
        </td>
        <td class="text-end">
          <div class="d-flex align-items-center justify-content-end gap-2">
            <a href="/owner/services/{{ service.id }}/edit" class="icon-btn" style="width:30px;height:30px;" aria-label="Edit {{ service.name }}">
              <i class="bi bi-pencil"></i>
            </a>
            <form method="post" action="/owner/services/{{ service.id }}/toggle" class="m-0 d-inline-flex">
              <button type="submit" class="icon-btn" style="width:30px;height:30px;" aria-label="{% if service.is_active %}Disable{% else %}Enable{% endif %} {{ service.name }}" title="{% if service.is_active %}Disable{% else %}Enable{% endif %}">
                {% if service.is_active %}
                <i class="bi bi-eye"></i>
                {% else %}
                <i class="bi bi-eye-slash"></i>
                {% endif %}
              </button>
            </form>
            <form method="post"
                  action="/owner/services/{{ service.id }}/delete"
                  class="m-0 d-inline-flex">
              <button
                  type="submit"
                  class="icon-btn"
                  style="width:30px;height:30px;"
                  aria-label="Delete {{ service.name }}"
                  title="Delete"
                  onclick="return confirm('Delete this service?');">
                  <i class="bi bi-trash"></i>
              </button>
            </form>
          </div>
        </td>
      </tr>
      {% else %}
      <tr>
        <td colspan="5" class="text-center cell-muted py-5">
          No services found for this tenant.
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
</file>

