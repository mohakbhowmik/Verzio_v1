{% extends "owner_base_mobile.html" %}

{% block title %}Appointments — Verzio Studio{% endblock %}

{% block content %}
<section class="owner-mobile-page" style="padding-bottom: 85px;">
    <div class="mb-2">
        <div class="text-uppercase small fw-bold text-muted">Appointments</div>
        <h1 class="h6 fw-bold mb-1">Manage Bookings</h1>
        <p class="text-muted small mb-0">Approve, complete, or cancel.</p>
    </div>

    <form method="get" action="/owner/appointments" class="owner-mobile-card p-2 mb-2">
        <input type="search" class="form-control form-control-sm mb-2" name="search" placeholder="Search customer" value="{{ search }}">
        <div class="row g-2">
            <div class="col-6">
                <select class="form-select form-select-sm" name="status">
                    <option value="all" {% if status == 'all' %}selected{% endif %}>All</option>
                    <option value="pending" {% if status == 'pending' %}selected{% endif %}>Pending</option>
                    <option value="confirmed" {% if status == 'confirmed' %}selected{% endif %}>Confirmed</option>
                    <option value="completed" {% if status == 'completed' %}selected{% endif %}>Completed</option>
                    <option value="cancelled" {% if status == 'cancelled' %}selected{% endif %}>Cancelled</option>
                    <option value="no_show" {% if status == 'no_show' %}selected{% endif %}>No show</option>
                </select>
            </div>
            <div class="col-6">
                <select class="form-select form-select-sm" name="sort">
                    <option value="newest" {% if sort == 'newest' %}selected{% endif %}>Newest</option>
                    <option value="oldest" {% if sort == 'oldest' %}selected{% endif %}>Oldest</option>
                </select>
            </div>
        </div>
        <button type="submit" class="btn btn-primary btn-sm w-100 mt-2">Apply</button>
    </form>

    <div class="d-flex flex-column gap-2">
        {% for appointment in appointments %}
        <div class="owner-mobile-card p-2">
            <div class="d-flex justify-content-between align-items-start mb-1">
                <div>
                    <div class="fw-bold small">{{ appointment.customer_name or appointment.customer_phone }}</div>
                    <div class="small text-muted">{{ appointment.service.name if appointment.service else 'Service removed' }}</div>
                </div>
                <span class="status-badge status-{{ appointment.status }}"><span class="dot"></span>{{ appointment.status|replace('_', ' ')|capitalize }}</span>
            </div>
            <div class="small text-muted mb-2">{{ appointment.appointment_time.strftime('%d %b %Y, %I:%M %p') }}</div>
            <div class="d-flex gap-2">
                {% if appointment.status == 'pending' %}
                <form method="post" action="/owner/appointments/{{ appointment.id }}/approve" class="flex-grow-1">
                    <button type="submit" class="btn btn-success btn-sm w-100">Approve</button>
                </form>
                <form method="post" action="/owner/appointments/{{ appointment.id }}/reject" class="flex-grow-1">
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">Reject</button>
                </form>
                {% elif appointment.status == 'confirmed' %}
                <form method="post" action="/owner/appointments/{{ appointment.id }}/complete" class="flex-grow-1">
                    <button type="submit" class="btn btn-success btn-sm w-100">Complete</button>
                </form>
                <form method="post" action="/owner/appointments/{{ appointment.id }}/cancel" class="flex-grow-1">
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">Cancel</button>
                </form>
                {% else %}
                {% endif %}
            </div>
        </div>
        {% else %}
        <div class="owner-mobile-card p-2 text-center text-muted small">No appointments found.</div>
        {% endfor %}
    </div>

    <a href="/owner/appointments" class="owner-mobile-fab" aria-label="New Booking">
        <i class="bi bi-plus-lg"></i>
    </a>
</section>
{% endblock %}
</file>

