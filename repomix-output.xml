                            <option value="Asia/Kolkata" {% if business and business.timezone == 'Asia/Kolkata' %}selected{% endif %}>Asia/Kolkata (IST)</option>
                            <option value="UTC" {% if not business or business.timezone == 'UTC' %}selected{% endif %}>UTC</option>
                            
                        </select>
                    </div>
                </div>
            </div>

            <!-- Operational Hours -->
            <div class="section-container">
                <div class="section-head">
                    <h2 class="section-title">Operational Hours</h2>
                </div>
                <div class="p-3">
                    {% set days = [
                        ('mon', 'Monday'), ('tue', 'Tuesday'), ('wed', 'Wednesday'), 
                        ('thu', 'Thursday'), ('fri', 'Friday'), ('sat', 'Saturday'), ('sun', 'Sunday')
                    ] %}
                    {% for key, label in days %}
                    <div class="d-flex align-items-center justify-content-between py-2 {% if not loop.last %}border-bottom{% endif %}" style="border-color: var(--border-subtle) !important;">
                        <div style="width: 100px;" class="fw-medium small">{{ label }}</div>
                        <div class="d-flex gap-2">
                            <input type="time" name="hours_{{ key }}_open" class="form-control form-control-sm" 
                                   value="{{ business.operational_hours[key][0] if business and business.operational_hours and key in business.operational_hours else '09:00' }}">
                            <input type="time" name="hours_{{ key }}_close" class="form-control form-control-sm" 
                                   value="{{ business.operational_hours[key][1] if business and business.operational_hours and key in business.operational_hours else '18:00' }}">
                        </div>
                        <div class="form-check form-switch ms-3">
                            <input class="form-check-input" type="checkbox" name="hours_{{ key }}_enabled" 
                                   {% if not business or (business.operational_hours and key in business.operational_hours) %}checked{% endif %}>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Rules & Preferences -->
        <div class="col-lg-5">
            <!-- Booking Logic -->
            <div class="section-container mb-4">
                <div class="section-head">
                    <h2 class="section-title">Booking Rules</h2>
                </div>
                <div class="p-3">
                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">Slot Interval (Min)</label>
                            <select name="slot_interval" class="form-select form-select-sm mono">
                                <option value="15" {% if business and business.slot_interval == 15 %}selected{% endif %}>15</option>
                                <option value="30" {% if not business or business.slot_interval == 30 %}selected{% endif %}>30</option>
                                <option value="60" {% if business and business.slot_interval == 60 %}selected{% endif %}>60</option>
                                <option value="90" {% if business and business.slot_interval == 90 %}selected{% endif %}>90</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Max Parallel Bookings</label>
                            <input type="number" name="max_parallel_bookings" class="form-control form-control-sm mono" value="{{ business.max_parallel_bookings if business else 1 }}">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Advance window (Days)</label>
                            <input type="number" name="advance_booking_days" class="form-control form-control-sm mono" value="{{ business.advance_booking_days if business else 14 }}">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">Approval Mode</label>
