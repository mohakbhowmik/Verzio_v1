"""
test_capacity.py — Automated verification for C1 duration awareness and collision resistance.
"""
from datetime import datetime, date, time
from database import SessionLocal, Business, Service, Appointment
from booking_engine import get_available_slots_for_day

db = SessionLocal()
biz = db.query(Business).first()
if not biz:
    print("❌ No business in database. Run 'python seed.py' first.")
    exit(1)

# Ensure business operational hours exist
biz.operational_hours = {
    "mon": ["09:00", "18:00"], "tue": ["09:00", "18:00"], "wed": ["09:00", "18:00"],
    "thu": ["09:00", "18:00"], "fri": ["09:00", "18:00"], "sat": ["09:00", "18:00"], "sun": ["09:00", "18:00"]
}
biz.max_parallel_bookings = 1
biz.accepting_bookings = True
biz.slot_interval = 30
db.commit()

# Find or create 30m and 60m test services
s30 = db.query(Service).filter(Service.business_id == biz.id, Service.duration == 30, Service.is_deleted == False).first()
if not s30:
    s30 = Service(business_id=biz.id, name="Cut (30m)", duration=30, price=300.0, is_active=True, is_deleted=False)
    db.add(s30)

s60 = db.query(Service).filter(Service.business_id == biz.id, Service.duration == 60, Service.is_deleted == False).first()
if not s60:
    s60 = Service(business_id=biz.id, name="Facial (60m)", duration=60, price=1200.0, is_active=True, is_deleted=False)
    db.add(s60)

db.commit()

test_date = date(2026, 11, 15)
day_start = datetime.combine(test_date, time.min)
day_end = datetime.combine(test_date, time.max)

# Clear existing appointments for test date using appointment_time
db.query(Appointment).filter(
    Appointment.business_id == biz.id,
    Appointment.appointment_time >= day_start,
    Appointment.appointment_time <= day_end
).delete()
db.commit()

# 1. Book a 60-min service at 10:00 AM (10:00 - 11:00 occupied)
test_appt = Appointment(
    business_id=biz.id,
    service_id=s60.id,
    customer_phone="919999999999",
    customer_name="Verification Client",
    appointment_time=datetime.combine(test_date, time(10, 0)),
    status="confirmed"
)
db.add(test_appt)
db.commit()

# 2. Check available slots for a 30m service
slots = get_available_slots_for_day(db, biz, test_date, s30)

print("\n--- Capacity Overlap Verification Results ---")
print("10:00 available? ->", "10:00" in slots, "(Expected: False)")
print("10:30 available? ->", "10:30" in slots, "(Expected: False - overlaps 60min booking)")
print("11:00 available? ->", "11:00" in slots, "(Expected: True - service freed at 11:00)")

assert "10:00" not in slots, "FAIL: 10:00 must be blocked!"
assert "10:30" not in slots, "FAIL: 10:30 must be blocked by 60min booking!"
assert "11:00" in slots, "FAIL: 11:00 must be available!"

print("\n🎉 ALL CAPACITY AND DURATION CHECKS PASSED!\n")
