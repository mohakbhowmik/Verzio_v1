{% block page_title %}
  {% if business %}Edit Business{% else %}New Business{% endif %}
{% endblock %}

{% block content %}
<form action="{{ form_action }}" method="post">

{% if error %}
<div class="alert alert-danger mb-4">
    {{ error }}
</div>
{% endif %}
    <div class="d-flex justify-content-between align-items-center mb-4">
